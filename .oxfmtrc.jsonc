{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "jsxSingleQuote": true,
  "printWidth": 80,
  "ignorePatterns": [
    "**/*.md",
    "**/*.svg",
    "**/*.ejs",
    "**/*.html",
    "package.json",
    ".umi",
    ".umi-production",
    ".umi-test",
    "*.min.js",
  ],
}
